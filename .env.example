# ---- Supabase (Fase 2) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Solo en servidor (Vercel API routes, GitHub Actions, Edge Functions). Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Generación de apps ----
# Prefijo del identificador Android de cada app generada (com.<algo>). Debe coincidir con
# public.android_namespace() en la migración de Supabase.
ANDROID_NAMESPACE=com.apkgen

# ---- Disparo del pipeline (Fase 4, solo servidor) ----
# Token fine-grained de GitHub con permiso "Contents: read & write" sobre este repo
# (necesario para POST /repos/{owner}/{repo}/dispatches).
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=JAllanMora/APK

# ---- Expo / EAS (Fase 4-5, secretos de GitHub Actions) ----
EXPO_TOKEN=
# Secreto compartido para verificar la firma del webhook de EAS (cabecera expo-signature).
EAS_WEBHOOK_SECRET=
